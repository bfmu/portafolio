---
import I18n from '../I18n.astro';
---

<section class="section" id="contacto">
  <div class="section__heading reveal" data-reveal>
    <span class="hash">##</span>
    <h2><I18n key="contact.title" /></h2>
    <span class="meta">
      <span class="dim">cat</span>
      <span class="v">contact.yml</span>
    </span>
  </div>

  <div class="contact-grid">
    <a class="contact-card reveal magnetic" data-reveal href="https://www.linkedin.com/in/bfmunozm96/" target="_blank" rel="noopener">
      <div class="contact-card__icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0H5C2.24 0 0 2.24 0 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5V5c0-2.76-2.24-5-5-5zM8 19H5V8h3v11zM6.5 6.7c-.97 0-1.7-.78-1.7-1.7s.73-1.7 1.7-1.7c.92 0 1.7.78 1.7 1.7s-.78 1.7-1.7 1.7zM20 19h-3v-5.6c0-1.4-.5-2.4-1.8-2.4-1.04 0-1.66.7-1.93 1.38-.1.24-.13.58-.13.92V19h-3V8h3v1.34c.4-.62 1.13-1.5 2.7-1.5 1.97 0 3.16 1.27 3.16 3.96V19z" /></svg>
      </div>
      <div>
        <div class="contact-card__label">linkedin:</div>
        <div class="contact-card__value">/in/bfmunozm96</div>
      </div>
    </a>

    <a class="contact-card reveal magnetic" data-reveal href="mailto:bfmumo@gmail.com">
      <div class="contact-card__icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
      </div>
      <div>
        <div class="contact-card__label">email:</div>
        <div class="contact-card__value">bfmumo@gmail.com</div>
      </div>
    </a>

    <a class="contact-card reveal magnetic" data-reveal href="https://github.com/bfmu" target="_blank" rel="noopener">
      <div class="contact-card__icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18.91-.25 1.89-.38 2.86-.38.97 0 1.95.13 2.86.38 2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56 4.56-1.53 7.85-5.83 7.85-10.91C23.5 5.65 18.35.5 12 .5z" /></svg>
      </div>
      <div>
        <div class="contact-card__label">github:</div>
        <div class="contact-card__value">@bfmu</div>
      </div>
    </a>

    <a class="contact-card reveal magnetic" data-reveal href="https://bfmu.dev/" target="_blank" rel="noopener">
      <div class="contact-card__icon" style="color: var(--peach)" aria-hidden="true">▲</div>
      <div>
        <div class="contact-card__label">website:</div>
        <div class="contact-card__value">bfmu.dev</div>
      </div>
    </a>
  </div>

  <footer class="foot reveal" data-reveal>
    <div class="row">
      <span class="dim">// built with</span>
      <span class="heart">♥</span>
      <span class="dim">·</span>
      <span class="dim">© 2026 Bryan Muñoz</span>
    </div>
    <div class="row">
      <span class="dim">$ git log --oneline -1</span>
      <span style="color: var(--peach)">a3f9c1b</span>
      <span class="dim">portfolio v2 — IDE rewrite</span>
    </div>
  </footer>
</section>
