---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Bilingual from '../Bilingual.astro';
import I18n from '../I18n.astro';
import { resolveProjectHref, isExternalProjectHref } from '../../lib/project-link';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data, slug } = project;

const href = resolveProjectHref(project);
const external = isExternalProjectHref(project);

const hostname = data.demo
  ? new URL(data.demo).host
  : data.repo
  ? new URL(data.repo).host
  : `${slug}.bfmu.dev`;
---

<a
  class="proj-card reveal"
  data-reveal
  data-cursor="grab"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <div class="proj-card__chrome">
    <span class="light l1" aria-hidden="true"></span>
    <span class="light l2" aria-hidden="true"></span>
    <span class="light l3" aria-hidden="true"></span>
    <span class="url">{hostname}</span>
  </div>

  <div class="proj-card__media">
    <Image
      src={data.cover}
      alt={data.title}
      widths={[360, 720]}
      sizes="360px"
      draggable={false}
    />
  </div>

  <div class="proj-card__body">
    <h3 class="proj-card__title">
      {slug}<span class="ext">.md</span>
    </h3>
    <p class="proj-card__desc">
      <Bilingual es={data.summary.es} en={data.summary.en} />
    </p>
    <div class="proj-card__stack">
      {data.stack.slice(0, 3).map((tech) => <span class="chip">{tech}</span>)}
    </div>
    <div class="proj-card__cta">
      {data.caseStudy ? (
        <I18n key="proj.read" />
      ) : (
        <Bilingual es={data.demo ? 'Ver demo' : 'Ver repositorio'} en={data.demo ? 'View demo' : 'View repo'} />
      )}
      <span>{external ? '↗' : '→'}</span>
    </div>
  </div>
</a>
