---
import { getCollection } from 'astro:content';
import I18n from '../I18n.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectListRow from './ProjectListRow.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.year - a.data.year);
---

<section class="section" id="proyectos">
  <div class="section__heading reveal" data-reveal>
    <span class="hash">##</span>
    <h2><I18n key="proj.title" /></h2>
    <span class="meta">
      <span class="dim">$</span>
      <span class="v">ls -la ./projects</span>
    </span>
  </div>

  <div class="proj-scroller">
    <div class="proj-scroller__hint">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M8 11V6.5a1.5 1.5 0 0 1 3 0V11" />
        <path d="M11 11V5.5a1.5 1.5 0 0 1 3 0V11" />
        <path d="M14 11V6.5a1.5 1.5 0 0 1 3 0V12" />
        <path d="M17 9a1.5 1.5 0 0 1 3 0v6a6 6 0 0 1-6 6h-1.5a6 6 0 0 1-5.74-4.26L5 13a1.5 1.5 0 0 1 2.6-1.5L8.5 13" />
      </svg>
      <span><I18n key="proj.drag" /></span>
      <span class="dim">·</span>
      <span class="key">←</span>
      <span class="key">→</span>
    </div>

    <div class="proj-track" data-proj-track data-cursor="drag">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>

  <div class="reveal" data-reveal style="margin-top: 24px;">
    <div class="ls-header" aria-hidden="true">
      <span class="col">PERMS</span>
      <span class="col">SIZE</span>
      <span class="col">YEAR</span>
      <span class="col">NAME</span>
      <span class="col" style="text-align: right">OPEN</span>
    </div>
    {projects.map((project) => <ProjectListRow project={project} />)}
  </div>
</section>

<script>
  import { setupProjTrack } from '../../scripts/proj-track';
  setupProjTrack();
</script>
