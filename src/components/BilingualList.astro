---
/**
 * Bilingual <ul> or <ol>. Each item has its own bilingual content; the
 * inactive language is hidden by the global i18n CSS rules.
 */
import type { Bilingual } from '../lib/bilingual';

interface Props {
  items: Bilingual[];
  ordered?: boolean;
  class?: string;
}

const { items, ordered = false, class: className } = Astro.props;
const Tag = ordered ? 'ol' : 'ul';
---

<Tag class:list={[className]}>
  {items.map((item) => (
    <li class="i18n">
      <span lang="es" set:html={item.es}></span>
      <span lang="en" set:html={item.en}></span>
    </li>
  ))}
</Tag>
