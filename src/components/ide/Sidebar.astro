---
/**
 * File-tree sidebar. Section files are derived from the SECTIONS registry so
 * adding a section there automatically updates the tree.
 *
 * Project files are still hardcoded here — step 5 swaps this stub for
 * `getCollection('projects')`. The shape of the array does not change, only
 * its source, so this module's contract stays stable.
 */
import { SECTIONS } from '../../lib/ide-sections';

interface ProjectFile {
  name: string;
  href: string;
}

const projectFiles: ProjectFile[] = [
  { name: 'flacow.md', href: '/projects/flacow' },
  { name: 'gifex.md',  href: '#proyectos' },
  { name: 'retos.md',  href: '#proyectos' },
];

const assetFiles = ['me.jpeg', 'flacow.png', 'gifex.png', 'retos.png'];

const totalCount = SECTIONS.length + projectFiles.length + assetFiles.length;
---

<aside class="sidebar" aria-label="Explorer">
  <div class="sidebar__rail">
    <div class="sidebar__rail-item">
      <span>Explorador</span>
      <span class="count">{totalCount}</span>
    </div>
  </div>

  <nav class="sidebar__tree">
    <div class="tree-folder is-open" data-folder>
      <span class="chev">▸</span>
      <span class="icon">▾</span>
      <span>portfolio</span>
    </div>

    <div class="tree-children">
      {SECTIONS.map((section, i) => (
        <a
          class:list={['tree-file', i === 0 && 'is-active']}
          href={`#${section.id}`}
          data-tree-key={section.treeKey}
        >
          <span class={`icon ext-${section.iconKind}`}>{section.iconGlyph}</span>
          <span>{section.file}</span>
        </a>
      ))}

      <div class="tree-folder is-open" data-folder>
        <span class="chev">▸</span>
        <span class="icon">▾</span>
        <span>projects/</span>
      </div>
      <div class="tree-children">
        {projectFiles.map((file) => (
          <a class="tree-file" href={file.href}>
            <span class="icon ext-md">M↓</span>
            <span>{file.name}</span>
          </a>
        ))}
      </div>

      <div class="tree-folder" data-folder>
        <span class="chev">▸</span>
        <span class="icon">▸</span>
        <span>assets/</span>
      </div>
      <div class="tree-children" style="max-height:0">
        {assetFiles.map((name) => (
          <a class="tree-file" href="#">
            <span class="icon ext-png">▣</span>
            <span>{name}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>
</aside>

<script>
  import { setupSidebarFolders } from '../../scripts/sidebar-folders';
  import type { Section } from '../../lib/ide-sections';

  setupSidebarFolders();

  document.addEventListener('section:change', (event) => {
    const detail = (event as CustomEvent<Section>).detail;
    document.querySelectorAll<HTMLElement>('.tree-file[data-tree-key]').forEach((el) => {
      el.classList.toggle('is-active', el.dataset.treeKey === detail.treeKey);
    });
  });
</script>
